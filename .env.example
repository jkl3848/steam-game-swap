# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steam_game_swap"

# Redis (BullMQ jobs)
REDIS_URL="redis://localhost:6379"

# App URLs
WEB_ORIGIN="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3000"

# Session (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Discord (same application for OAuth + bot)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_BOT_INVITE_URL="https://discord.gg/your-invite"

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=""

# Optional
NODE_ENV="development"
PORT=3000
GIFT_REMINDER_DAYS_BEFORE=3
