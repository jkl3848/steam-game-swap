# Firebase (production / deploy)
FIREBASE_PROJECT_ID="steam-game-swap-dev"
# Local only — path to service account JSON (never commit)
GOOGLE_APPLICATION_CREDENTIALS=""

# Firestore emulator (set automatically by `firebase emulators:start`)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FUNCTIONS_EMULATOR_HOST="127.0.0.1:5001"

# App URLs
WEB_ORIGIN="http://localhost:5173"
# OAuth callbacks — use Hosting URL in production (e.g. https://your-app.web.app)
API_PUBLIC_URL="http://localhost:5001/steam-game-swap-dev/us-central1/api"

# Session (min 32 chars in production)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Discord (same application for OAuth + bot)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_BOT_INVITE_URL="https://discord.gg/your-invite"

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=""

# Optional
NODE_ENV="development"
PORT=3000
GIFT_REMINDER_DAYS_BEFORE=3
